<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XcavateMobileApp.Pages.ModifyUserProfilePage"
             xmlns:navigationbar="clr-namespace:PlutoFramework.Components.NavigationBar;assembly=PlutoFramework"
             xmlns:form="clr-namespace:PlutoFramework.Components.Form;assembly=PlutoFramework"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons;assembly=PlutoFramework"
             xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate;assembly=PlutoFramework"
             Title="{Binding Title}">
    <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1" AbsoluteLayout.LayoutFlags="All">
        <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1" AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout Margin="0, 0, 0, 0"
                                Spacing="15"
                                Padding="0, 0, 0, 200">
                <AbsoluteLayout HeightRequest="200"
                                >
                    <AbsoluteLayout AbsoluteLayout.LayoutBounds="0,0,1,160"
                                    BackgroundColor="#aaaaaa"
                                    AbsoluteLayout.LayoutFlags="WidthProportional">
                        <Image AbsoluteLayout.LayoutBounds="0,0,1,160"
                               AbsoluteLayout.LayoutFlags="WidthProportional"
                               Source="xcavatelandscape.png"
                               Aspect="AspectFill"
                                />
                        <!--
                        <Image AbsoluteLayout.LayoutBounds="0.5, 0.5, 40, 40"
                               
                               AbsoluteLayout.LayoutFlags="PositionProportional">
                            <Image.Source>
                                <FontImageSource Color="Black"
                                                 Glyph="&#xf030;"
                                                 FontFamily="FontAwesome"
                                                 Size="20" />
                            </Image.Source>
                        </Image>

                        <AbsoluteLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickProfileBackgroundCommand}" />
                        </AbsoluteLayout.GestureRecognizers>
                        -->
                    </AbsoluteLayout>

                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                            Stroke="{AppThemeBinding Light=White, Dark=Black}"
                            StrokeThickness="5"
                            AbsoluteLayout.LayoutBounds="10,1,80,80"
                            AbsoluteLayout.LayoutFlags="YProportional">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="40" />
                        </Border.StrokeShape>

                        <AbsoluteLayout BackgroundColor="Gray"
                                        AbsoluteLayout.LayoutBounds="0.5, 0.5, 80, 80"
                                        AbsoluteLayout.LayoutFlags="PositionProportional">
                            <Image Aspect="AspectFill"
                                   AbsoluteLayout.LayoutBounds="0.5, 0.5, 70, 70"
                                   AbsoluteLayout.LayoutFlags="PositionProportional"
                                   Source="{Binding ProfilePicture}" />

                            

                            <AbsoluteLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickProfilePictureCommand}" />
                            </AbsoluteLayout.GestureRecognizers>
                        </AbsoluteLayout>
                    </Border>

                    <Border BackgroundColor="#cccccc"
                            StrokeThickness="0"
                            AbsoluteLayout.LayoutBounds="60,1,25,25"
                            AbsoluteLayout.LayoutFlags="YProportional">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12.5" />
                        </Border.StrokeShape>

                        <Image AbsoluteLayout.LayoutBounds="0.5, 0.5, 20, 20"
                               Margin="5"
                               AbsoluteLayout.LayoutFlags="PositionProportional">
                            <Image.Source>
                                <FontImageSource Color="Black"
                                                 Glyph="&#xf030;"
                                                 FontFamily="FontAwesome"
                                                 Size="30" />
                            </Image.Source>
                        </Image>
                    </Border>
                </AbsoluteLayout>

                <VerticalStackLayout Spacing="15"
                                     Margin="20,20,20,0"
                                    x:Name="verticalStackLayout"
                                     >

                    <Label Text="Nickname" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
                    <form:FormInputView Placeholder="Enter your nickname (optional)"
                                        CardWidth="{Binding Source={x:Reference verticalStackLayout}, Path=Width}"
                                        Text="{Binding Nickname}" />

                    <Label Text="Bio" FontSize="14" TextColor="{AppThemeBinding Light=#9ca3af, Dark=#d1d5db}" />
                    <form:FormLargeInputView Placeholder="Enter your bio (optional)" Text="{Binding Bio}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 1, 1, 80"
                AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                         IsVisible="{Binding SaveLayoutIsVisible}">

            <Grid AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 50"
                  AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                  ColumnSpacing="15"
                  Margin="20, 0, 20, 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <buttons:BasicGrayButton Text="Cancel"
                                         Command="{Binding CancelCommand}"
                                         Grid.Column="0"
                                    />

                <buttons:ElevatedButton Text="Save"
                                        Grid.Column="1"
                                        Command="{Binding SaveCommand}"
                                        ButtonState="{Binding SaveButtonState}"/>
            </Grid>
        </AbsoluteLayout>
        
        <navigationbar:TopNavigationBar />
    </AbsoluteLayout>
</template:PageTemplate>