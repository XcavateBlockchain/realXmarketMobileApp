<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <!-- The iOS workload cannot be installed on Linux (the Android publish CI runs on ubuntu), so only build Android there. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0-android</TargetFrameworks>
    <!--<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>-->
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
    <!-- <TargetFrameworks>$(TargetFrameworks);net6.0-tizen</TargetFrameworks> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>XcavateMobileApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <!-- https://github.com/CommunityToolkit/Maui/issues/2205 -->
    <NoWarn>XC0103;NU1605</NoWarn>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <UseMauiEssentials>true</UseMauiEssentials>

    <!-- Display name -->
    <ApplicationTitle>realXmarket</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.xcavate.realxmarket</ApplicationId>
    <ApplicationIdGuid>36D62217-2B7E-41BF-AAA9-8A559B7F5A88</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>0.33</ApplicationDisplayVersion>
    <PackageVersion>0.33</PackageVersion>
    <ApplicationVersion>52</ApplicationVersion>

    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Ensure APK/AAB native library alignment is compatible with Android 16 KB page-size devices. -->
    <AndroidZipAlignment>16</AndroidZipAlignment>
  </PropertyGroup>

  <PropertyGroup>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' and '$(Configuration)'=='Debug'">
    <MtouchExtraArgs>--setenv=DOTNET_EnableDiagnostics=0</MtouchExtraArgs>
    <MauiHotReloadEnabled>false</MauiHotReloadEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
    <RuntimeIdentifiers>ios-arm64</RuntimeIdentifiers>
    <MtouchInfoPlist>Platforms\iOS\Info.plist</MtouchInfoPlist>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' and '$(Configuration)'=='Debug'">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
    <CodesignKey>Apple Development: Created via API (AB35Z2969M)</CodesignKey>
    <CodesignProvision>VS: com.xcavate.realxmarket Development</CodesignProvision>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-android'">
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#3B4F74" ForegroundScale="0.65" />
    <!-- Generates the Firebase resource values; without this the default FirebaseApp
         never initializes and FCM token retrieval fails. The file is gitignored -
         obtain it from the realxmarket-notifications Firebase project. -->
    <GoogleServicesJson Include="Platforms\Android\google-services.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net10.0-android'">
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#3B4F74" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
    <!-- iOS counterpart of GoogleServicesJson above. Firebase.Core.App.Configure()
         reads this from the bundle root and throws without it, taking the whole
         notification startup down with it. The file is gitignored - obtain it from
         the realxmarket-notifications Firebase project. -->
    <BundleResource Include="GoogleService-Info.plist" />

    <!-- Push notifications capability. Without it RegisterForRemoteNotifications()
         fails with "no valid aps-environment entitlement string found", the device
         never receives an APNs token and FCM has nothing to deliver to. The value has
         to match the provisioning profile the build is signed with: the development
         profile for Debug, the App Store profile CI publishes with for Release.
         It lives here rather than in Platforms\iOS\Entitlements.plist because that
         file is not part of the build - no CodesignEntitlements property points at
         it - and because the value differs per configuration. -->
    <CustomEntitlements Condition="'$(Configuration)'=='Debug'" Include="aps-environment" Type="String" Value="development" />
    <CustomEntitlements Condition="'$(Configuration)'!='Debug'" Include="aps-environment" Type="String" Value="production" />
  </ItemGroup>


  <ItemGroup>
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\realxmarkettransparentsplash.png">
      <Color>#3B4F74</Color>
      <BaseSize>128,128</BaseSize>
    </MauiSplashScreen>

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <MauiFont Include="Resources\Fonts\xcavatefont.ttf" Alias="XcavateFont" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Components\Sumsub\SumsubUserPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Components\XcavateMainPageTopNavigationBarView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="NoAccountShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="OnboardingShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\InvestorMainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\ModifyUserProfilePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\ModifyUserProfilePopupView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\NoAccountMainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\UserProfilePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\UserTypeSelectionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\WelcomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Templates\TemplateDictionary.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Templates\TopNavigationBar.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="XcavateAppShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\realXmarketPlutoFramework\PlutoFramework\PlutoFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Images\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="12.3.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NoAccountShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Pages\NoAccountMainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>

</Project>
