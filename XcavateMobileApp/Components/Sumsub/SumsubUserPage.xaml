<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate;assembly=PlutoFramework"
                       xmlns:sumsub="clr-namespace:PlutoFramework.Components.Sumsub;assembly=PlutoFramework"
                       xmlns:card="clr-namespace:PlutoFramework.Components.Card;assembly=PlutoFramework"
                       x:Class="XcavateMobileApp.Components.Sumsub.SumsubUserPage"
                       Title="KYC Information">
    <ScrollView>
        <VerticalStackLayout Padding="20,10,20,120" Spacing="15">

            <!-- Loading indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               HorizontalOptions="Center"
                               IsRunning="True"
                               IsVisible="True" />

            <!-- Dynamic Sumsub status component (shows approved/rejected/needsResubmit) -->
            <VerticalStackLayout x:Name="StatusComponentLayout"
                                 IsVisible="False"
                                 Spacing="15">
                <Label x:Name="StatusLabel"
                       Text="Verification Status"
                       FontSize="Header"
                       FontAttributes="Bold" />
                <!-- Status component placeholder - populated at runtime -->
                <ContentView x:Name="StatusComponentContainer" />
            </VerticalStackLayout>

            <!-- User Information Card -->
            <card:Card x:Name="UserInfoCard"
                       IsVisible="False"
                       CardPadding="15,12">
                <card:Card.View>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="User Information"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Label x:Name="SubstrateKeyLabel" />
                        <Label x:Name="ApplicantIdLabel" />
                        <Label x:Name="EmailLabel" />
                        <Label x:Name="PhoneLabel" />
                        <Label x:Name="PlatformLabel" />
                    </VerticalStackLayout>
                </card:Card.View>
            </card:Card>

            <!-- Verification Status Card -->
            <card:Card x:Name="StatusCard"
                       IsVisible="False"
                       CardPadding="15,12">
                <card:Card.View>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Verification Status"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        <Label x:Name="StatusLabel" />
                        <Label x:Name="RoleLabel" />
                        <Label x:Name="AttemptsLabel" />
                        <Label x:Name="PriorityLabel" />
                    </VerticalStackLayout>
                </card:Card.View>
            </card:Card>

            <!-- Timeline Card -->
            <VerticalStackLayout Spacing="10" x:Name="Timeline" IsVisible="False">
                <Label Text="Timeline"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                <VerticalStackLayout x:Name="TimelineLayout"
                                             Spacing="8" />
            </VerticalStackLayout>

            <!-- Error message -->
            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{StaticResource DangerousRed}" />
        </VerticalStackLayout>
    </ScrollView>
</template:PageTemplate>